# EmailJS credentials for the contact form.
#
# These are client-side public values — they ship in the built bundle and are not
# secrets in the cryptographic sense. They are kept out of the repo so the account
# can be rotated in one place, and are locked down by restricting Allowed Origins
# in the EmailJS dashboard.
#
# Local development: copy this file to `.env` and fill in the real values.
# Production: the same three keys are stored as GitHub Actions repository secrets
# and injected into the build step by .github/workflows/deploy.yml.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
